# Supabase (public — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://nhalrckiplhfyuqezzqf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server-only — keep secret)
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server-only — keep secret)
RESEND_API_KEY=

# Public export API key — used by external consumers (Power BI, scripts) to
# authenticate against /api/v1/export/*. Generate with:
#   node -e "console.log('ammoc_' + require('crypto').randomBytes(32).toString('base64url'))"
EXPORT_API_KEY=

# Bot API key (server-only — keep secret) — used by the OpenClaw agent to
# authenticate against /api/v1/bot/* (read + write). Separate from EXPORT_API_KEY
# so it can be revoked independently. Quem tiver esta chave pode agir como
# qualquer funcionário via o header X-Acting-User. Generate with:
#   node -e "console.log('bot_' + require('crypto').randomBytes(32).toString('base64url'))"
BOT_API_KEY=
